# ---------- Database ----------
# Supabase: Project Settings -> Database -> Connection string (URI). Use the "Session pooler"
# URI (works over IPv4) e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local dev (docker compose up db): postgresql+psycopg://docmind:docmind@localhost:5432/docmind
DATABASE_URL=postgresql+psycopg://docmind:docmind@localhost:5432/docmind

# ---------- Auth ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# ---------- AI provider (OpenRouter free tier by default) ----------
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated; the next model is tried automatically when one is rate-limited
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
# Embeddings (free). EMBEDDING_DIM must match the model's output size and
# is baked into the table at first start — changing it later needs a re-index.
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIM=1024
# Optional: use a different OpenAI-compatible provider for embeddings
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=

# ---------- RAG tuning ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MIN_SIMILARITY=0.15
MAX_UPLOAD_MB=25

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
